<UserControl x:Class="RenewalReviewBuilder.App.Views.ClaimsRangeReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ClaimsRangeCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE5F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ClaimsRangeLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,10,0,0">
            <Border Background="#EAF8F8"
                    BorderBrush="#8DD3C7"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Claims Range review"
                                   Foreground="#071B4D"
                                   FontWeight="Bold"
                                   FontSize="18" />
                        <TextBlock x:Name="ClaimsRangeAvailabilityTextBlock"
                                   Text="{Binding AvailabilityText}"
                                   Foreground="#53627A"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,16,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{Binding StatusBackground}"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="ClaimsRangeStatusTextBlock"
                                   Text="{Binding StatusText}"
                                   Foreground="{Binding StatusForeground}"
                                   FontWeight="Bold"
                                   FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ClaimsRangeCard}">
                    <StackPanel>
                        <TextBlock Text="PRIOR REPORT" Foreground="#008C8C" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="{Binding PriorClientName}" Foreground="#071B4D" FontWeight="Bold" FontSize="16" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Policy" Style="{StaticResource ClaimsRangeLabel}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PriorPolicyNumber}" Foreground="#071B4D" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Period" Style="{StaticResource ClaimsRangeLabel}" Margin="0,0,14,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PriorPeriodText}" Foreground="#071B4D" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ClaimsRangeCard}">
                    <StackPanel>
                        <TextBlock Text="CURRENT REPORT" Foreground="#003A8C" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="{Binding CurrentClientName}" Foreground="#071B4D" FontWeight="Bold" FontSize="16" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Policy" Style="{StaticResource ClaimsRangeLabel}" Margin="0,0,14,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentPolicyNumber}" Foreground="#071B4D" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Period" Style="{StaticResource ClaimsRangeLabel}" Margin="0,0,14,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentPeriodText}" Foreground="#071B4D" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ClaimsRangeIdentityReviewBorder"
                    Background="#FFF8E6"
                    BorderBrush="#E7C45A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,12"
                    Visibility="{Binding IdentityConfirmationRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Client identity confirmation required"
                                   Foreground="#6E5300"
                                   FontWeight="Bold"
                                   FontSize="13" />
                        <TextBlock Text="The policy numbers can be compared, but the client names differ between reports. Confirm the pairing for this review session before export."
                                   Foreground="#6E5300"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,16,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="ClaimsRangeConfirmIdentityButton"
                            Content="Confirm for this session"
                            Command="{Binding ConfirmIdentityCommand}"
                            IsEnabled="{Binding CanConfirmIdentity}"
                            Background="#003A8C"
                            Foreground="White"
                            BorderBrush="#003A8C"
                            Padding="14,8"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ClaimsRangeCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Certificate counts by paid-claims range"
                               Foreground="#071B4D"
                               FontWeight="Bold"
                               FontSize="16" />
                    <TextBlock Text="All extracted period, benefit, and range rows are shown. Counts are certificates and are not normalized for changes in eligible lives."
                               Foreground="#53627A"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,3,0,10" />
                    <DataGrid x:Name="ClaimsRangeComparisonGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              MinHeight="250"
                              MaxHeight="380"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Period" Binding="{Binding PeriodRole}" Width="82" />
                            <DataGridTextColumn Header="Report period" Binding="{Binding PeriodText}" Width="150" />
                            <DataGridTextColumn Header="Benefit" Binding="{Binding Benefit}" Width="150" />
                            <DataGridTextColumn Header="Claims range" Binding="{Binding BandLabel}" Width="135" />
                            <DataGridTextColumn Header="Certificates" Binding="{Binding CertificateCount}" Width="95" />
                            <DataGridTextColumn Header="Page" Binding="{Binding SourcePage}" Width="58" />
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceFile}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="#FFFDF4"
                    BorderBrush="#E7D89C"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Client takeaway"
                               Foreground="#071B4D"
                               FontWeight="Bold"
                               FontSize="16" />
                    <TextBlock Text="Editable for this review: the approved wording flows into the PowerPoint slide for this export."
                               Foreground="#6E5B12"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,3,0,8" />
                    <TextBox x:Name="ClaimsRangeTakeawayTextBox"
                             Text="{Binding ConsultantTakeaway, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="78"
                             Padding="10,8"
                             Background="White"
                             BorderBrush="#D9C46F"
                             BorderThickness="1" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ClaimsRangeCard}">
                <StackPanel>
                    <TextBlock Text="Validation"
                               Foreground="#071B4D"
                               FontWeight="Bold"
                               FontSize="16" />
                    <ItemsControl x:Name="ClaimsRangeValidationItemsControl"
                                  ItemsSource="{Binding ValidationIssues}"
                                  Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#53627A"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
