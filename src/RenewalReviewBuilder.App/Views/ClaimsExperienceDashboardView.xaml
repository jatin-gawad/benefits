<UserControl x:Class="RenewalReviewBuilder.App.Views.ClaimsExperienceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F9FC">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextNavyBrush" Color="#071B4D" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#003A8C" />
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BenchmarkVioletBrush" Color="#6D28D9" />
        <SolidColorBrush x:Key="BenchmarkPurpleBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#F97316" />
        <SolidColorBrush x:Key="TealBrush" Color="#0F8B8D" />

        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CBD5E1" BlurRadius="12" ShadowDepth="2" Opacity="0.22" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextNavyBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource DeepBlueBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="BenchmarkPurpleButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BenchmarkPurpleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BenchmarkPurpleBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#7C3AED" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#7C3AED" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#4C1D95" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#4C1D95" />
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.92" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClaimsCard" TargetType="Border" BasedOn="{StaticResource DashboardCard}">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="ClaimsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextNavyBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ClaimsTinyText" TargetType="TextBlock" BasedOn="{StaticResource MiniLabel}">
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="ClaimsMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextNavyBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ClaimsChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#F5F3FF" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Book of Business" Foreground="{StaticResource DeepBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="  &gt;  " Style="{StaticResource ClaimsTinyText}" />
                    <TextBlock Text="Claims Experience" Foreground="{StaticResource TextNavyBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Claims Experience Dashboard" Foreground="{StaticResource TextNavyBrush}" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Portfolio-level claims performance, utilization, loss-ratio trends, and executive insights across the book of business."
                           Style="{StaticResource MiniLabel}"
                           FontSize="14"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox Width="230"
                          Height="42"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Margin="0,0,10,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Jun 1, 2024 - May 31, 2025" />
                    <ComboBoxItem Content="Last 12 Months" />
                    <ComboBoxItem Content="Last 24 Months" />
                    <ComboBoxItem Content="All History" />
                </ComboBox>
                <ComboBox Width="150"
                          Height="42"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Margin="0,0,10,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="All Plans" />
                    <ComboBoxItem Content="EHC" />
                    <ComboBoxItem Content="Dental" />
                    <ComboBoxItem Content="Drug" />
                </ComboBox>
                <Button Content="Filters"
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="105"
                        Margin="0,0,10,0" />
                <Button Content="Export"
                        Style="{StaticResource BenchmarkPurpleButtonStyle}"
                        Width="100"
                        Click="Export_Click" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#EDE9FE" HorizontalAlignment="Left">
                        <TextBlock Text="$" Foreground="{StaticResource BenchmarkVioletBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Total Claims Paid" Style="{StaticResource ClaimsTinyText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="$2,847,602" Style="{StaticResource ClaimsMetricValue}" />
                    <TextBlock Text="up 13.3% vs prior" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <Polyline Points="0,18 22,15 44,17 66,10 88,12 110,5 132,9" Stroke="{StaticResource BenchmarkVioletBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#EEF2FF" HorizontalAlignment="Left">
                        <TextBlock Text="PE" Foreground="{StaticResource BrightBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Claims per Employee" Style="{StaticResource ClaimsTinyText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="$837" Style="{StaticResource ClaimsMetricValue}" />
                    <TextBlock Text="up 11.9% vs prior" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <Polyline Points="0,16 22,13 44,15 66,13 88,12 110,6 132,11" Stroke="{StaticResource BrightBlueBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#DCFCE7" HorizontalAlignment="Left">
                        <TextBlock Text="LR" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Loss Ratio (Paid)" Style="{StaticResource ClaimsTinyText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="84.2%" Style="{StaticResource ClaimsMetricValue}" />
                    <TextBlock Text="down 4.6 pts" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <Polyline Points="0,9 22,13 44,10 66,14 88,8 110,11 132,10" Stroke="{StaticResource GreenBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#DBEAFE" HorizontalAlignment="Left">
                        <TextBlock Text="M" Foreground="{StaticResource BrightBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Plan Members" Style="{StaticResource ClaimsTinyText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="3,400" Style="{StaticResource ClaimsMetricValue}" />
                    <TextBlock Text="up 1.2% vs prior" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <Polyline Points="0,17 22,16 44,12 66,15 88,8 110,11 132,14" Stroke="{StaticResource BrightBlueBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,10,0">
                <StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#FFEDD5" HorizontalAlignment="Left">
                        <TextBlock Text="AC" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Avg Claim per Claimant" Style="{StaticResource ClaimsTinyText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="$1,956" Style="{StaticResource ClaimsMetricValue}" />
                    <TextBlock Text="down 8.6% vs prior" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <Polyline Points="0,14 22,11 44,13 66,9 88,13 110,6 132,10" Stroke="{StaticResource OrangeBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ClaimsCard}" Margin="0">
                <StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#CCFBF1" HorizontalAlignment="Left">
                        <TextBlock Text="C" Foreground="{StaticResource TealBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Claimants" Style="{StaticResource ClaimsTinyText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                    <TextBlock Text="1,456" Style="{StaticResource ClaimsMetricValue}" />
                    <TextBlock Text="up 4.2% vs prior" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <Polyline Points="0,17 22,15 44,16 66,14 88,13 110,5 132,9" Stroke="{StaticResource TealBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Monthly Claims Trend (Paid)" Style="{StaticResource ClaimsSectionTitle}" />
                        <ComboBox DockPanel.Dock="Right" Width="120" Height="32" SelectedIndex="0">
                            <ComboBoxItem Content="Paid Claims" />
                            <ComboBoxItem Content="Incurred" />
                        </ComboBox>
                    </DockPanel>
                    <Grid Height="220">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" />
                        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" />
                        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" />
                        <Canvas Margin="34,12,16,24">
                            <Polyline Points="0,150 38,104 76,55 114,96 152,86 190,34 228,58 266,46 304,30 342,18" Stroke="{StaticResource BenchmarkVioletBrush}" StrokeThickness="3" />
                            <Polyline Points="0,170 38,130 76,92 114,116 152,104 190,96 228,86 266,72 304,58 342,44" Stroke="#94A3B8" StrokeThickness="2" StrokeDashArray="4,3" />
                            <Polyline Points="0,122 38,106 76,92 114,88 152,82 190,72 228,66 266,54 304,42 342,30" Stroke="{StaticResource BrightBlueBrush}" StrokeThickness="2" StrokeDashArray="5,4" />
                        </Canvas>
                        <TextBlock Text="$400K" Style="{StaticResource ClaimsTinyText}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Text="$0" Style="{StaticResource ClaimsTinyText}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ClaimsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Cumulative Claims (Paid)" Style="{StaticResource ClaimsSectionTitle}" Margin="0,0,0,14" />
                    <Canvas Height="220" Margin="16,8,16,8">
                        <Polyline Points="0,180 36,130 72,96 108,72 144,52 180,36 216,22 252,8" Stroke="{StaticResource BenchmarkVioletBrush}" StrokeThickness="3" />
                        <Polyline Points="0,194 36,150 72,118 108,92 144,72 180,54 216,38 252,22" Stroke="#64748B" StrokeThickness="2" />
                        <Polyline Points="0,206 36,168 72,138 108,112 144,92 180,74 216,58 252,42" Stroke="{StaticResource BrightBlueBrush}" StrokeDashArray="4,4" StrokeThickness="2" />
                    </Canvas>
                    <TextBlock Text="Current period $2.85M | Prior period $2.51M | Industry $2.24M" Style="{StaticResource ClaimsTinyText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ClaimsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Loss Ratio Trend (Paid)" Style="{StaticResource ClaimsSectionTitle}" Margin="0,0,0,14" />
                    <Canvas Height="220" Margin="16,8,16,8">
                        <Polyline Points="0,44 36,62 72,58 108,76 144,88 180,84 216,74 252,78" Stroke="{StaticResource BenchmarkVioletBrush}" StrokeThickness="3" />
                        <Polyline Points="0,60 36,66 72,72 108,82 144,90 180,94 216,88 252,84" Stroke="#64748B" StrokeThickness="2" />
                        <Polyline Points="0,70 36,68 72,66 108,68 144,70 180,72 216,70 252,68" Stroke="{StaticResource BrightBlueBrush}" StrokeDashArray="4,4" StrokeThickness="2" />
                    </Canvas>
                    <TextBlock Text="Paid LR 84.2% | Prior 79.6% | Industry 88.1%" Style="{StaticResource ClaimsTinyText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource ClaimsCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Executive Insights" Style="{StaticResource ClaimsSectionTitle}" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource ClaimsChip}">
                            <TextBlock Text="AI" Foreground="{StaticResource BenchmarkVioletBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </DockPanel>
                    <Border Background="#F0FDF4" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Positive Trend" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Text="Overall claims trend is 4.6 pts above prior period but remains below industry average." TextWrapping="Wrap" Style="{StaticResource ClaimsTinyText}" Margin="0,6,0,8" />
                            <Button Content="Investigate" Style="{StaticResource OutlineButtonStyle}" Height="32" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF7ED" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Monitor Closely" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" />
                            <TextBlock Text="Drug trend is 5.2 pts higher than industry average." TextWrapping="Wrap" Style="{StaticResource ClaimsTinyText}" Margin="0,6,0,8" />
                            <Button Content="Investigate" Style="{StaticResource OutlineButtonStyle}" Height="32" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF2F2" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="High Cost Claimants" Foreground="#DC2626" FontWeight="Bold" />
                            <TextBlock Text="24 claimants exceeded $50K, accounting for 24.6% of total claims." TextWrapping="Wrap" Style="{StaticResource ClaimsTinyText}" Margin="0,6,0,8" />
                            <Button Content="Investigate" Style="{StaticResource OutlineButtonStyle}" Height="32" />
                        </StackPanel>
                    </Border>
                    <Button Content="View All Insights" Style="{StaticResource BenchmarkPurpleButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Claims by Benefit Category (Paid)" Style="{StaticResource ClaimsSectionTitle}" Margin="0,0,0,16" />
                        <Grid Width="150" Height="150">
                            <Ellipse Fill="{StaticResource BenchmarkPurpleBrush}" />
                            <Ellipse Fill="White" Width="78" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="$2.85M" Foreground="{StaticResource TextNavyBrush}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Text="Total Paid" Style="{StaticResource ClaimsTinyText}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="12,34,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Drugs     $1,232,845     43.3%     +18.2%" Foreground="{StaticResource TextNavyBrush}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="Paramedical     $531,764     18.7%     +9.8%" Foreground="{StaticResource TextNavyBrush}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="Dental     $478,223     16.8%     +8.1%" Foreground="{StaticResource TextNavyBrush}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Text="Hospital     $286,993     10.1%     +6.3%" Foreground="{StaticResource TextNavyBrush}" Margin="0,0,0,8" />
                        <Button Grid.Row="4" Content="View Detailed Category Analysis" Style="{StaticResource OutlineButtonStyle}" Margin="0,8,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ClaimsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Top 5 Claimants by Paid Amount" Style="{StaticResource ClaimsSectionTitle}" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="1   Drug Claimant           $126,842     4.5%" />
                        <TextBlock Grid.Row="1" Text="2   Drug Claimant            $98,517     3.5%" />
                        <TextBlock Grid.Row="2" Text="3   Paramedical Claimant     $76,321     2.7%" />
                        <TextBlock Grid.Row="3" Text="4   Drug Claimant            $65,443     2.3%" />
                        <TextBlock Grid.Row="4" Text="5   Drug Claimant            $54,218     1.9%" />
                    </Grid>
                    <Button Content="View Top 25 Claimants" Style="{StaticResource OutlineButtonStyle}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ClaimsCard}">
                <StackPanel>
                    <TextBlock Text="Utilization Metrics" Style="{StaticResource ClaimsSectionTitle}" Margin="0,0,0,14" />
                    <TextBlock Text="Claimants per 100 Members            42.8     up 3.0%" Margin="0,0,0,8" />
                    <TextBlock Text="Total Claims                         8,956    up 6.1%" Margin="0,0,0,8" />
                    <TextBlock Text="Average Claims per Claimant          6.2      up 1.8%" Margin="0,0,0,8" />
                    <TextBlock Text="New Claimants                        487      up 4.7%" Margin="0,0,0,8" />
                    <TextBlock Text="High Cost Claimants (&gt; $50K)         24       -" Margin="0,0,0,8" />
                    <TextBlock Text="% Claims from High Cost Claimants    24.6%    up 2.1 pts" Margin="0,0,0,8" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ClaimsCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Claims by Age Band (Paid)" Style="{StaticResource ClaimsSectionTitle}" Margin="0,0,0,14" />
                    <Canvas Height="190">
                        <Rectangle Canvas.Left="36" Canvas.Top="108" Width="28" Height="58" Fill="{StaticResource BenchmarkVioletBrush}" RadiusX="5" RadiusY="5" />
                        <Rectangle Canvas.Left="96" Canvas.Top="82" Width="28" Height="84" Fill="{StaticResource BenchmarkVioletBrush}" RadiusX="5" RadiusY="5" />
                        <Rectangle Canvas.Left="156" Canvas.Top="52" Width="28" Height="114" Fill="{StaticResource BenchmarkVioletBrush}" RadiusX="5" RadiusY="5" />
                        <Rectangle Canvas.Left="216" Canvas.Top="24" Width="28" Height="142" Fill="{StaticResource BenchmarkVioletBrush}" RadiusX="5" RadiusY="5" />
                        <Rectangle Canvas.Left="276" Canvas.Top="38" Width="28" Height="128" Fill="{StaticResource BenchmarkVioletBrush}" RadiusX="5" RadiusY="5" />
