<UserControl x:Class="RenewalReviewBuilder.App.Views.ProposalComparisonWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RenewalReviewBuilder.App.Models"
             Background="{StaticResource DsBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="ProposalPrimaryButton" TargetType="Button" BasedOn="{StaticResource DsPrimaryButton}">
            <Setter Property="Background" Value="#155EEF" />
            <Setter Property="BorderBrush" Value="#155EEF" />
            <Setter Property="Padding" Value="16,9" />
        </Style>

        <Style x:Key="ProposalSecondaryButton" TargetType="Button" BasedOn="{StaticResource DsSecondaryButton}">
            <Setter Property="Foreground" Value="#155EEF" />
            <Setter Property="Padding" Value="16,9" />
        </Style>

        <Style x:Key="ProposalBreadcrumbLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#155EEF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="BreadcrumbText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BreadcrumbText" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="#003A8C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProposalDataGridCell" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ProposalDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#071B4D" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="QuoteValueTemplate" DataType="{x:Type models:QuoteComparisonValueDto}">
            <Border Background="{Binding BackgroundBrush}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,7"
                    Margin="0,0,8,6"
                    Width="190"
                    MinHeight="64"
                    ToolTip="{Binding SourceText}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding CarrierName}"
                                   Foreground="#071B4D"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}"
                                   DockPanel.Dock="Right"
                                   Foreground="{Binding ForegroundBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Value}"
                               Foreground="#334155"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Reference}"
                               Foreground="#64748B"
                               FontSize="9.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CanonicalValueTemplate" DataType="{x:Type models:ProposalCanonicalComparisonValueDto}">
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,7"
                    Margin="0,0,8,6"
                    Width="220"
                    MinHeight="68"
                    ToolTip="{Binding SourceText}">
                <StackPanel>
                    <TextBlock Text="{Binding CarrierName}"
                               Foreground="#071B4D"
                               FontSize="11"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}"
                               Foreground="#334155"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Detail}"
                               Foreground="#64748B"
                               FontSize="9.5"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="560" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Clients"
                            Style="{StaticResource ProposalBreadcrumbLinkButton}"
                            Click="ProposalBreadcrumbClients_Click" />
                    <TextBlock Text="  &gt;  " Style="{StaticResource DsSmallText}" />
                    <TextBlock Text="{Binding ClientName}" Style="{StaticResource DsSmallText}" FontWeight="SemiBold" />
                    <TextBlock Text="  &gt;  " Style="{StaticResource DsSmallText}" />
                    <TextBlock Text="Proposal Comparison" Style="{StaticResource DsSmallText}" />
                </StackPanel>
                <TextBlock Text="Proposal Intelligence Comparison" Style="{StaticResource DsPageTitle}" />
                <TextBlock Text="Saved carrier proposals with financial, plan-design, validation, and underwriting comparisons."
                           Style="{StaticResource DsBodyText}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="24,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Current Carrier" Style="{StaticResource DsSmallText}" />
                    <TextBlock Text="{Binding CurrentCarrier}" Style="{StaticResource DsCardTitle}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Lowest Premium" Style="{StaticResource DsSmallText}" />
                    <TextBlock Text="{Binding LowestAnnualPremiumText}" Style="{StaticResource DsCardTitle}" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Premium Spread" Style="{StaticResource DsSmallText}" />
                    <TextBlock Text="{Binding AnnualPremiumSpreadText}" Style="{StaticResource DsCardTitle}" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Readiness" Style="{StaticResource DsSmallText}" />
                    <TextBlock Text="{Binding ReadinessStatus}"
                               Foreground="{Binding ReadinessForegroundBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DsCard}" Padding="12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh"
                            Style="{StaticResource ProposalSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Refresh_Click" />
                    <Button Content="Build Comparison Workbook"
                            Style="{StaticResource ProposalPrimaryButton}"
                            Click="MoreActions_Click" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding QuoteCountText}" Foreground="#155EEF" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding FinancialComparisonCountText}" Style="{StaticResource DsSmallText}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding CarrierPlanDesignCountText}" Style="{StaticResource DsSmallText}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding UnderwritingComparisonCountText}" Style="{StaticResource DsSmallText}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding ReviewItemCountText}" Style="{StaticResource DsSmallText}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Visibility="{Binding LoadingVisibility}"
                Style="{StaticResource DsCard}"
                Margin="0,0,0,16">
            <TextBlock Text="Loading saved proposal analysis..." Style="{StaticResource DsBodyText}" />
        </Border>

        <Border Grid.Row="2"
                Visibility="{Binding EmptyVisibility}"
                Style="{StaticResource DsCard}"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="No saved proposal comparison data" Style="{StaticResource DsSectionTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DsBodyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Visibility="{Binding ErrorVisibility}"
                Style="{StaticResource DsCard}"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Proposal comparison could not be loaded" Foreground="{StaticResource DsDangerBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DsBodyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Visibility="{Binding ContentVisibility}">
            <Border Background="{Binding ReadinessBackgroundBrush}"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="{Binding ReadinessStatus}"
                               Foreground="{Binding ReadinessForegroundBrush}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding ReadinessMessage}"
                               Foreground="#475569"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <TabControl x:Name="ProposalComparisonTabs" Height="650" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                <TabItem Header="Proposals">
                    <DataGrid x:Name="ProposalSummaryGrid" ItemsSource="{Binding ProposalSummaries}"
                              Style="{StaticResource DsDataGrid}"
                              CellStyle="{StaticResource ProposalDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ProposalDataGridColumnHeader}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              RowHeight="64"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Carrier / Version" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6" ToolTip="{Binding SourceText}">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#071B4D" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LowestPremiumLabel}" Foreground="#047857" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Annual Premium" Binding="{Binding AnnualPremiumText}" Width="125" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Monthly Premium" Binding="{Binding MonthlyPremiumText}" Width="125" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="From Lowest" Binding="{Binding DifferenceFromLowestText}" Width="120" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Financial" Binding="{Binding FinancialStatusText}" Width="90" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Plan Design" Binding="{Binding PlanDesignStatusText}" Width="95" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Validation" Binding="{Binding ValidationStatusText}" Width="100" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Review" Binding="{Binding ReviewStatusText}" Width="115" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTemplateColumn Header="Readiness" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ReadinessBackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="6">
                                            <TextBlock Text="{Binding ReadinessStatus}" Foreground="{Binding ReadinessForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Financials">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="250" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Premium Comparison" Style="{StaticResource DsSectionTitle}" Margin="0,0,0,8" />
                        <DataGrid x:Name="ProposalPremiumGrid" Grid.Row="1" ItemsSource="{Binding PremiumComparisons}"
                                  Style="{StaticResource DsDataGrid}" CellStyle="{StaticResource ProposalDataGridCell}"
                                  ColumnHeaderStyle="{StaticResource ProposalDataGridColumnHeader}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  MinRowHeight="78" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Benefit" Binding="{Binding Subject}" Width="170" ElementStyle="{StaticResource DsTableTextBlock}" />
                                <DataGridTextColumn Header="Class / Tier" Binding="{Binding Detail}" Width="180" ElementStyle="{StaticResource DsTableTextBlock}" />
                                <DataGridTemplateColumn Header="Saved Proposals" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource CanonicalValueTemplate}" Margin="8,6,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Coverage" Binding="{Binding MissingText}" Width="90" ElementStyle="{StaticResource DsTableTextBlock}" />
                                <DataGridTemplateColumn Header="Status" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Border Background="{Binding StatusBackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="6"><TextBlock Text="{Binding ComparisonStatus}" Foreground="{Binding StatusForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></Border></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Rate Comparison" Style="{StaticResource DsSectionTitle}" Margin="0,14,0,8" />
                        <DataGrid x:Name="ProposalRateGrid" Grid.Row="3" ItemsSource="{Binding RateComparisons}"
                                  Style="{StaticResource DsDataGrid}" CellStyle="{StaticResource ProposalDataGridCell}"
                                  ColumnHeaderStyle="{StaticResource ProposalDataGridColumnHeader}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  MinRowHeight="78" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Benefit" Binding="{Binding Subject}" Width="170" ElementStyle="{StaticResource DsTableTextBlock}" />
                                <DataGridTextColumn Header="Dimensions" Binding="{Binding Detail}" Width="220" ElementStyle="{StaticResource DsTableTextBlock}" />
                                <DataGridTemplateColumn Header="Saved Proposals" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource CanonicalValueTemplate}" Margin="8,6,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Coverage" Binding="{Binding MissingText}" Width="90" ElementStyle="{StaticResource DsTableTextBlock}" />
                                <DataGridTemplateColumn Header="Status" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Border Background="{Binding StatusBackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="6"><TextBlock Text="{Binding ComparisonStatus}" Foreground="{Binding StatusForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></Border></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Current vs Quote">
                    <DataGrid x:Name="ProposalCurrentVsQuoteGrid" ItemsSource="{Binding BenefitComparisons}"
                              Style="{StaticResource DsDataGrid}" CellStyle="{StaticResource ProposalDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ProposalDataGridColumnHeader}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              MinRowHeight="76" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding BenefitCategory}" Width="120" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Benefit" Binding="{Binding BenefitName}" Width="155" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Provision" Binding="{Binding ProvisionName}" Width="145" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="105" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTemplateColumn Header="Current Plan" Width="205">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6" ToolTip="{Binding CurrentSourceText}">
                                            <TextBlock Text="{Binding CurrentValue}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CurrentSourceText}" Foreground="#64748B" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Saved Quotes" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding QuoteValues}" ItemTemplate="{StaticResource QuoteValueTemplate}" Margin="8,6,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Border Background="{Binding StatusBackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="6"><TextBlock Text="{Binding ComparisonStatus}" Foreground="{Binding StatusForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></Border></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Carrier Plan Design">
                    <DataGrid x:Name="ProposalCarrierPlanDesignGrid" ItemsSource="{Binding CarrierPlanDesignComparisons}"
                              Style="{StaticResource DsDataGrid}" CellStyle="{StaticResource ProposalDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ProposalDataGridColumnHeader}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              MinRowHeight="78" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Benefit" Binding="{Binding Subject}" Width="180" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Provision" Binding="{Binding Detail}" Width="180" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTemplateColumn Header="Saved Proposals" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource CanonicalValueTemplate}" Margin="8,6,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Coverage" Binding="{Binding MissingText}" Width="90" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Border Background="{Binding StatusBackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="6"><TextBlock Text="{Binding ComparisonStatus}" Foreground="{Binding StatusForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></Border></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Underwriting">
                    <DataGrid x:Name="ProposalUnderwritingGrid" ItemsSource="{Binding UnderwritingComparisons}"
                              Style="{StaticResource DsDataGrid}" CellStyle="{StaticResource ProposalDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ProposalDataGridColumnHeader}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              MinRowHeight="78" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="165" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Term" Binding="{Binding Subject}" Width="180" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTextColumn Header="Benefit" Binding="{Binding Detail}" Width="150" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTemplateColumn Header="Saved Proposals" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource CanonicalValueTemplate}" Margin="8,6,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Coverage" Binding="{Binding MissingText}" Width="90" ElementStyle="{StaticResource DsTableTextBlock}" />
                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Border Background="{Binding StatusBackgroundBrush}" CornerRadius="6" Padding="8,5" Margin="6"><TextBlock Text="{Binding ComparisonStatus}" Foreground="{Binding StatusForegroundBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /></Border></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Findings &amp; Review">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProposalFindingsItemsControl" ItemsSource="{Binding Issues}" Margin="14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PlanDesignComparisonIssueDto}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Severity}" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#334155" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Carrier}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Message}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Context}" Foreground="#64748B" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource DsCard}" Margin="0,16,0,0">
            <DockPanel LastChildFill="True">
                <Button Content="View Client Plan Design"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ProposalSecondaryButton}"
                        Click="ViewFullPlanDesign_Click" />
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource DsSmallText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BuiltAtText, StringFormat=Data refreshed: {0}}"
                               Style="{StaticResource DsSmallText}"
                               FontSize="10"
                               Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
