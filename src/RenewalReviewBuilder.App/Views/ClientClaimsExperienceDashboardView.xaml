<UserControl x:Class="RenewalReviewBuilder.App.Views.ClientClaimsExperienceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F9FC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="ClaimsPurpleBrush" Color="#6D28D9" />
        <SolidColorBrush x:Key="ClaimsPurpleDarkBrush" Color="#4C1D95" />
        <SolidColorBrush x:Key="ClaimsBlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="ClaimsGreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="ClaimsOrangeBrush" Color="#F97316" />
        <SolidColorBrush x:Key="ClaimsTealBrush" Color="#0F8B8D" />
        <SolidColorBrush x:Key="ClaimsRedBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="ClaimsTextBrush" Color="#071B4D" />
        <SolidColorBrush x:Key="ClaimsMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="ClaimsBorderBrush" Color="#E2E8F0" />

        <Style x:Key="ClaimsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ClaimsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0B2341" BlurRadius="14" ShadowDepth="2" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClaimsMiniLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ClaimsMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ClaimsTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ClaimsTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ClaimsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ClaimsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ClaimsPurpleDarkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ClaimsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ClaimsButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ClaimsPurpleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ClaimsPurpleBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ClaimsComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ClaimsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ClaimsTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0">
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Client Workspace" Foreground="{StaticResource ClaimsPurpleDarkBrush}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="  &gt;  " Style="{StaticResource ClaimsMiniLabelStyle}" />
                    <TextBlock Text="Claims Experience" Foreground="{StaticResource ClaimsTextBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Claims Experience - Client Dashboard" Foreground="{StaticResource ClaimsTextBrush}" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource ClaimsMiniLabelStyle}" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="PeriodFilterComboBox"
                          Width="260"
                          Style="{StaticResource ClaimsComboStyle}"
                          DisplayMemberPath="DisplayLabel"
                          Margin="0,0,10,0"
                          SelectionChanged="Filters_Changed" />
                <ComboBox x:Name="BenefitFilterComboBox" Width="138" Style="{StaticResource ClaimsComboStyle}" SelectedIndex="0" Margin="0,0,10,0" SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="All Plans" Tag="all" />
                    <ComboBoxItem Content="EHC" Tag="ehc" />
                    <ComboBoxItem Content="Dental" Tag="dental" />
                </ComboBox>
                <Button Content="Filters" Style="{StaticResource ClaimsButtonStyle}" Width="96" Margin="0,0,10,0" Click="ApplyFilters_Click" />
                <Button Content="Upload Claims"
                        Style="{StaticResource ClaimsButtonStyle}"
                        Width="122"
                        Margin="0,0,10,0"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="UploadClaimsExperience_Click" />
                <Button Content="Export" Style="{StaticResource ClaimsPrimaryButtonStyle}" Width="96" Click="Export_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,0,16" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" Margin="0,42">
                <Border Width="52" Height="52" CornerRadius="26" Background="#F5F3FF" HorizontalAlignment="Center">
                    <TextBlock Text="CL" Foreground="{StaticResource ClaimsPurpleBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No saved claims experience for this client yet." Foreground="{StaticResource ClaimsTextBrush}" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,14,0,4" />
                <TextBlock Text="Select a folder containing either a renewal-experience PDF or Lives/Premium/Claims reports. The importer records the source and keeps complete renewal periods ahead of interim reports."
                           Style="{StaticResource ClaimsMiniLabelStyle}"
                           TextAlignment="Center"
                           Width="660" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,14">
                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,0">
                        <TextBlock Text="Current" Foreground="{StaticResource ClaimsPurpleDarkBrush}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource ClaimsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,8,0">
                        <TextBlock Text="Prior" Foreground="{StaticResource ClaimsTextBrush}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource ClaimsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <TextBlock Text="PriorPrior" Foreground="{StaticResource ClaimsTextBrush}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </StackPanel>
                <Button Content="Upload Claims Experience"
                        Style="{StaticResource ClaimsPrimaryButtonStyle}"
                        Padding="18,10"
                        HorizontalAlignment="Center"
                        Click="UploadClaimsExperience_Click" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <UniformGrid Columns="6" Margin="0,0,0,14">
                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#EDE9FE" HorizontalAlignment="Left">
                            <TextBlock Text="$" Foreground="{StaticResource ClaimsPurpleBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Total Claims Paid" Style="{StaticResource ClaimsMiniLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding TotalClaimsPaidText}" Foreground="{StaticResource ClaimsTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalClaimsSubtext}" Foreground="{StaticResource ClaimsGreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <Polyline Points="0,18 22,15 44,17 66,10 88,12 110,5 132,9" Stroke="{StaticResource ClaimsPurpleBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#EEF2FF" HorizontalAlignment="Left">
                            <TextBlock Text="PE" Foreground="{StaticResource ClaimsBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Claims per Current Employee" Style="{StaticResource ClaimsMiniLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ClaimsPerEmployeeText}" Foreground="{StaticResource ClaimsTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding MembersText}" Foreground="{StaticResource ClaimsMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        <Polyline Points="0,16 22,13 44,15 66,13 88,12 110,6 132,11" Stroke="{StaticResource ClaimsBlueBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#DCFCE7" HorizontalAlignment="Left">
                            <TextBlock Text="LR" Foreground="{StaticResource ClaimsGreenBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Loss Ratio (Paid)" Style="{StaticResource ClaimsMiniLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding LossRatioText}" Foreground="{StaticResource ClaimsTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding LossRatioSubtext}" Foreground="{Binding LossRatioBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <Polyline Points="0,18 22,10 44,13 66,16 88,8 110,12 132,10" Stroke="{StaticResource ClaimsGreenBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#DBEAFE" HorizontalAlignment="Left">
                            <TextBlock Text="PM" Foreground="{StaticResource ClaimsBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Plan Members" Style="{StaticResource ClaimsMiniLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding PlanMembersText}" Foreground="{StaticResource ClaimsTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding PlanText}" Foreground="{StaticResource ClaimsMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        <Polyline Points="0,16 22,15 44,13 66,17 88,11 110,6 132,12" Stroke="{StaticResource ClaimsBlueBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#FFEDD5" HorizontalAlignment="Left">
                            <TextBlock Text="AC" Foreground="{StaticResource ClaimsOrangeBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Avg Spend per Insured Life" Style="{StaticResource ClaimsMiniLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AverageClaimText}" Foreground="{StaticResource ClaimsTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding ClaimantDataStatus}" Foreground="{StaticResource ClaimsMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        <Polyline Points="0,18 22,14 44,17 66,13 88,16 110,8 132,12" Stroke="{StaticResource ClaimsOrangeBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ClaimsCardStyle}">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#CCFBF1" HorizontalAlignment="Left">
                            <TextBlock Text="C" Foreground="{StaticResource ClaimsTealBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Average Insured Lives" Style="{StaticResource ClaimsMiniLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ClaimantsText}" Foreground="{StaticResource ClaimsTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding ClaimantDataStatus}" Foreground="{StaticResource ClaimsMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        <Polyline Points="0,17 22,15 44,16 66,14 88,17 110,8 132,12" Stroke="{StaticResource ClaimsTealBrush}" StrokeThickness="2" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding TrendTitle}" Style="{StaticResource ClaimsTitleStyle}" DockPanel.Dock="Left" />
                            <TextBlock Text="Current period" Style="{StaticResource ClaimsMiniLabelStyle}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding MonthlyTrendRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource ClaimsMiniLabelStyle}" />
                                        <Border Grid.Column="1" Height="12" Background="#F1F5F9" CornerRadius="6" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="#6D28D9" CornerRadius="6" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{StaticResource ClaimsTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="AverageSpendComparisonPanel"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource ClaimsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Average Spend per Insured Life" Style="{StaticResource ClaimsTitleStyle}" />
                                <TextBlock Text="{Binding AverageSpendComparison.PeriodContextText}"
                                           Style="{StaticResource ClaimsMiniLabelStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Width="26" Height="6" Background="#3B82F6" CornerRadius="3" Margin="0,6,7,0" />
                                <TextBlock Text="Current" Style="{StaticResource ClaimsMiniLabelStyle}" Margin="0,0,16,0" />
                                <Border Width="26" Height="6" Background="#BDBDBD" CornerRadius="3" Margin="0,6,7,0" />
                                <TextBlock Text="Prior" Style="{StaticResource ClaimsMiniLabelStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#E8F0FC"
                                BorderBrush="#3B82F6"
                                BorderThickness="5,0,0,0"
                                Padding="18,14"
                                Margin="0,14,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding AverageSpendComparison.ScopeLabel}"
                                               Style="{StaticResource ClaimsMiniLabelStyle}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding AverageSpendComparison.CurrentValueText}"
                                               Foreground="#111827"
                                               FontSize="34"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding AverageSpendComparison.PriorValueText}"
                                               Style="{StaticResource ClaimsMiniLabelStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding AverageSpendComparison.ChangeText}"
                                               Foreground="{Binding AverageSpendComparison.ChangeBrush}"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding AverageSpendComparison.ChangeAmountText}"
                                               Style="{StaticResource ClaimsMiniLabelStyle}"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding AverageSpendComparison.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Coverage}"
                                                   Foreground="#111827"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,14,0">
                                            <Border Height="10" Background="#E5E7EB" CornerRadius="5" Margin="0,0,0,7">
                                                <Border Width="{Binding CurrentBarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Background="#3B82F6"
                                                        CornerRadius="5" />
                                            </Border>
                                            <Border Height="10" Background="#E5E7EB" CornerRadius="5">
                                                <Border Width="{Binding PriorBarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Background="#BDBDBD"
                                                        CornerRadius="5" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding CurrentValueText}"
                                                       Foreground="#111827"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding PriorValueText}"
                                                       Style="{StaticResource ClaimsMiniLabelStyle}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding ChangeText}"
                                                       Foreground="{Binding ChangeBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ChangeAmountText}"
                                                       Style="{StaticResource ClaimsMiniLabelStyle}"
                                                       FontSize="10.5"
                                                       HorizontalAlignment="Right"
                                                       TextAlignment="Right"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AverageSpendComparison.LargestChangeText}"
                                       Foreground="{StaticResource ClaimsTextBrush}"
                                       FontSize="11.5"
                                       VerticalAlignment="Bottom" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding AverageSpendComparison.CurrentPeriodText}"
                                           Style="{StaticResource ClaimsMiniLabelStyle}"
                                           FontSize="10.5"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding AverageSpendComparison.PriorPeriodText}"
                                           Style="{StaticResource ClaimsMiniLabelStyle}"
                                           FontSize="10.5"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding AverageSpendComparison.ComparisonBasisText}"
                                           Style="{StaticResource ClaimsMiniLabelStyle}"
                                           FontSize="10.5"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Loss Ratio Trend (Paid)" Style="{StaticResource ClaimsTitleStyle}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding LossRatioTrendRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource ClaimsMiniLabelStyle}" />
                                        <Border Grid.Column="1" Height="12" Background="#F1F5F9" CornerRadius="6" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{Binding BarBrush}" CornerRadius="6" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{StaticResource ClaimsTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ClaimsCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Top 5 Claimants by Paid Amount" Style="{StaticResource ClaimsTitleStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="Claimant-level data is not saved in the current SQLite model yet." Style="{StaticResource ClaimsMiniLabelStyle}" />
                        <Button Content="View Saved Claims Rows" Style="{StaticResource ClaimsButtonStyle}" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ClaimsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Utilization Metrics" Style="{StaticResource ClaimsTitleStyle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding UtilizationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Metric}" Style="{StaticResource ClaimsMiniLabelStyle}" Foreground="{StaticResource ClaimsTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource ClaimsTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="Transparent" Padding="0,2">
                <DockPanel>
                    <TextBlock Text="{Binding DataAccuracyText}" Foreground="{Binding DataAccuracyBrush}" FontSize="11.5" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource ClaimsMiniLabelStyle}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                </DockPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
