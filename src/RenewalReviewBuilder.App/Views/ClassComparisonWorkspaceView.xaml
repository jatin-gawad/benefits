<UserControl x:Class="RenewalReviewBuilder.App.Views.ClassComparisonWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RenewalReviewBuilder.App.Models"
             MinWidth="0"
             Background="Transparent"
             SizeChanged="ClassComparisonWorkspaceView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="ComparisonCard" TargetType="Border" BasedOn="{StaticResource DsCard}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ComparisonActionButton" TargetType="Button" BasedOn="{StaticResource DsSecondaryButton}">
            <Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource DsPrimaryNavyBrush}" />
        </Style>
        <Style x:Key="SwapIconButton" TargetType="Button" BasedOn="{StaticResource ComparisonActionButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource DsPlanAccentSoftBrush}" /><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DsPlanAccentBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#EDE9FE" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComparisonPrimaryButton" TargetType="Button" BasedOn="{StaticResource DsPrimaryButton}">
            <Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="18,8" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource DsPlanAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DsPlanAccentBrush}" />
        </Style>
        <Style x:Key="ComparisonSegmentButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" /><Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegmentRoot" Height="40" MinWidth="130" Background="White" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" Padding="18,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentRoot" Property="Background" Value="{StaticResource DsPlanAccentSoftBrush}" />
                            <Setter TargetName="SegmentRoot" Property="BorderBrush" Value="{StaticResource DsPlanAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DsPlanAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SegmentRoot" Property="BorderThickness" Value="2" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DifferenceSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="46" Height="24">
                    <Border x:Name="Track" Background="#CBD5E1" CornerRadius="12" />
                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{StaticResource DsPlanAccentBrush}" />
                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClassSelector" TargetType="ComboBox">
            <Setter Property="Height" Value="66" /><Setter Property="MinHeight" Value="66" /><Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
            <Setter Property="Background" Value="White" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="ClassSelectorItemTemplate" DataType="{x:Type models:ClassComparisonClassCard}">
            <Grid Margin="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource DsPlanAccentSoftBrush}">
                    <TextBlock Text="{Binding ClassCode}" Foreground="{StaticResource DsPlanAccentBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource DsPrimaryNavyBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding RecommendedBadgeVisibility}">
                    <TextBlock Text="Recommended" Foreground="{StaticResource DsSuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DsFilterTextBox}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="SearchBorder" Background="White" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid><ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource DsTextMutedBrush}" FontSize="13" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="Text" Value="{x:Null}"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource DsInfoBrush}" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Text" Value="" /><Condition Property="IsKeyboardFocused" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" /></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClassPairGrid" TargetType="DataGrid" BasedOn="{StaticResource DsDataGrid}">
            <Setter Property="FontSize" Value="13" /><Setter Property="MinRowHeight" Value="48" /><Setter Property="ColumnHeaderHeight" Value="44" />
            <Setter Property="GridLinesVisibility" Value="All" /><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DsBorderBrush}" /><Setter Property="VerticalGridLinesBrush" Value="{StaticResource DsBorderBrush}" />
            <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" /><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="ClassPairColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAFBFD" /><Setter Property="Foreground" Value="{StaticResource DsPrimaryNavyBrush}" />
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="ComparisonSetupCard" Grid.Row="0" Style="{StaticResource ComparisonCard}" Padding="20" Visibility="{Binding PairSetupVisibility}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Comparison setup" Style="{StaticResource DsSectionTitle}" FontSize="18" VerticalAlignment="Center" />
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource DsBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9,4" Margin="12,0,0,0">
                        <TextBlock Text="{Binding PairSelectionCountText}" Foreground="{StaticResource DsTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <Grid x:Name="ClassSelectorGrid">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="BaselineSelectorHost" Grid.Column="0">
                        <TextBlock Text="Baseline" Style="{StaticResource DsBodyText}" FontSize="13" Margin="0,0,0,7" />
                        <ComboBox x:Name="BaselineClassComboBox" Style="{StaticResource ClassSelector}" ItemsSource="{Binding Classes}" ItemTemplate="{StaticResource ClassSelectorItemTemplate}" SelectedValuePath="ClassName" SelectedValue="{Binding BaselineClassName, Mode=OneWay}" SelectionChanged="BaselineClassComboBox_SelectionChanged" AutomationProperties.Name="Baseline class" />
                    </StackPanel>
                    <Button x:Name="SwapClassesButton" Grid.Column="1" Width="44" Height="44" Margin="15,29,15,0" Style="{StaticResource SwapIconButton}" ToolTip="Swap baseline and comparison classes" AutomationProperties.Name="Swap classes" Click="SwapClasses_Click">
                        <Path Width="22" Height="18" Stretch="Uniform" Stroke="{StaticResource DsTextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 2,5 L 18,5 M 14,1 L 18,5 L 14,9 M 18,13 L 2,13 M 6,9 L 2,13 L 6,17" />
                    </Button>
                    <StackPanel x:Name="ComparisonSelectorHost" Grid.Column="2">
                        <TextBlock Text="Compare against" Style="{StaticResource DsBodyText}" FontSize="13" Margin="0,0,0,7" />
                        <ComboBox x:Name="ComparisonClassComboBox" Style="{StaticResource ClassSelector}" ItemsSource="{Binding ComparisonClassOptions}" ItemTemplate="{StaticResource ClassSelectorItemTemplate}" SelectedItem="{Binding SelectedComparisonClass, Mode=OneWay}" SelectionChanged="ComparisonClassComboBox_SelectionChanged" AutomationProperties.Name="Comparison class" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="SetupControlsGrid" Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Content="All benefits" GroupName="ComparisonView" IsChecked="{Binding AllBenefitsSelected, Mode=OneWay}" Style="{StaticResource ComparisonSegmentButton}" Click="AllBenefits_Click" />
                        <RadioButton Content="Key differences" GroupName="ComparisonView" IsChecked="{Binding KeyBenefitsSelected, Mode=OneWay}" Style="{StaticResource ComparisonSegmentButton}" Click="KeyDifferences_Click" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="34,0,12,0">
                            <TextBlock Text="Highlight differences" Style="{StaticResource DsBodyText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox IsChecked="{Binding HighlightDifferences, Mode=OneWay}" Style="{StaticResource DifferenceSwitch}" Click="HighlightDifferences_Click" AutomationProperties.Name="Highlight differences" />
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel x:Name="ComparisonActionPanel" Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Export" Style="{StaticResource ComparisonActionButton}" Margin="8,0,0,0" Click="ExportComparison_Click" />
                        <Button x:Name="MoreActionsButton" Content="More ⌄" Style="{StaticResource ComparisonActionButton}" Margin="8,0,0,0" Click="MoreActions_Click">
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem Header="Export to Excel" Click="ExportComparison_Click" /><MenuItem Header="Save comparison" Click="SaveComparison_Click" />
                                <MenuItem Header="Reset filters" Click="ResetFilters_Click" /><MenuItem Header="View audit history" Click="ViewAuditHistory_Click" /><Separator />
                                <MenuItem Header="View cost analysis" Tag="Cost Analysis" Click="OpenAdvancedTab_Click" /><MenuItem Header="View value score" Tag="Value Score" Click="OpenAdvancedTab_Click" />
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                        <Button Content="Build presentation" Style="{StaticResource ComparisonPrimaryButton}" Margin="8,0,0,0" IsEnabled="False" ToolTip="Class Comparison is not yet mapped to the existing plan-comparison PowerPoint pipeline." />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Visibility="{Binding LoadingVisibility}" Style="{StaticResource DsEmptyStateCard}"><TextBlock Text="Loading class comparison…" Style="{StaticResource DsBodyText}" /></Border>
        <Border Grid.Row="0" Visibility="{Binding ErrorVisibility}" Style="{StaticResource DsEmptyStateCard}">
            <StackPanel><TextBlock Text="Class comparison could not load" Style="{StaticResource DsSectionTitle}" /><TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource DsBodyText}" Foreground="{StaticResource DsDangerBrush}" TextWrapping="Wrap" Margin="0,6,0,14" /><Button Content="Retry" Style="{StaticResource ComparisonActionButton}" HorizontalAlignment="Left" Click="Retry_Click" /></StackPanel>
        </Border>
        <Border Grid.Row="0" Visibility="{Binding NotEnoughClassesVisibility}" Style="{StaticResource DsEmptyStateCard}">
            <StackPanel><TextBlock Text="Two plan classes are required" Style="{StaticResource DsSectionTitle}" /><TextBlock Text="This client does not yet have two valid plan-design classes. Review or import the plan design before creating a class comparison." Style="{StaticResource DsBodyText}" TextWrapping="Wrap" Margin="0,6,0,14" /><Button Content="Review plan design" Style="{StaticResource ComparisonActionButton}" HorizontalAlignment="Left" Tag="Benefit Summary" Click="OpenAdvancedTab_Click" /></StackPanel>
        </Border>
        <Border Grid.Row="1" Visibility="{Binding NoComparableFeaturesVisibility}" Style="{StaticResource DsEmptyStateCard}" Margin="0,12,0,0">
            <StackPanel><TextBlock Text="No comparable plan-design features" Style="{StaticResource DsSectionTitle}" /><TextBlock Text="Two classes were found, but no normalized comparable features are available. Review the saved extraction and source evidence." Style="{StaticResource DsBodyText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
        </Border>

        <Border Grid.Row="1" Visibility="{Binding PairContentVisibility}" Style="{StaticResource ComparisonCard}" Padding="0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.Resources><Style TargetType="Border" x:Key="KpiDivider"><Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /><Setter Property="Padding" Value="22,16" /></Style></Grid.Resources>
                <Border Style="{StaticResource KpiDivider}"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="#EFF6FF"><TextBlock Text="≡" Foreground="{StaticResource DsInfoBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="{Binding TotalBenefitLines}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DsPrimaryNavyBrush}" /><TextBlock Text="Benefit lines" Style="{StaticResource DsBodyText}" FontSize="13" /></StackPanel></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource KpiDivider}"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource DsPlanAccentSoftBrush}"><TextBlock Text="!" Foreground="{StaticResource DsPlanAccentBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="{Binding MaterialDifferenceCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DsPrimaryNavyBrush}" /><TextBlock Text="Material differences" Style="{StaticResource DsBodyText}" FontSize="13" /></StackPanel></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource KpiDivider}"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="#FFF7ED"><TextBlock Text="$" Foreground="#D97706" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="{Binding CostDifferenceCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DsPrimaryNavyBrush}" /><TextBlock Text="Cost differences" Style="{StaticResource DsBodyText}" FontSize="13" /></StackPanel></StackPanel></Border>
                <Border Grid.Column="3" Padding="22,16"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="#ECFEFF"><TextBlock Text="⌾" Foreground="{StaticResource DsAccentTealBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="{Binding EligibilityDifferenceCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DsPrimaryNavyBrush}" /><TextBlock Text="Eligibility differences" Style="{StaticResource DsBodyText}" FontSize="13" /></StackPanel></StackPanel></Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Visibility="{Binding PairContentVisibility}" Style="{StaticResource ComparisonCard}" Padding="0" Margin="0,12,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid x:Name="TableHeaderGrid" Margin="20,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Benefit-by-benefit comparison" Style="{StaticResource DsSectionTitle}" FontSize="18" /><TextBlock Text="Differences are highlighted automatically." Style="{StaticResource DsBodyText}" FontSize="13" Margin="0,3,0,0" /></StackPanel>
                    <WrapPanel x:Name="TableHeaderControls" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox x:Name="SearchTextBox" Width="300" Height="38" Style="{StaticResource SearchTextBoxStyle}" Tag="Find a benefit" Text="{Binding SearchText, Mode=OneWay}" TextChanged="SearchTextBox_TextChanged" AutomationProperties.Name="Find a benefit" />
                        <CheckBox IsChecked="{Binding ShowDifferencesOnly, Mode=OneWay}" VerticalAlignment="Center" Margin="18,0,8,0" Click="ShowDifferencesOnly_Click" AutomationProperties.Name="Show differences only" />
                        <TextBlock Text="Show differences only" Style="{StaticResource DsBodyText}" FontSize="13" VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>
                <DataGrid x:Name="ComparisonDataGrid" Grid.Row="1" ItemsSource="{Binding FilteredComparisonRows}" Style="{StaticResource ClassPairGrid}" ColumnHeaderStyle="{StaticResource ClassPairColumnHeader}" AutoGenerateColumns="False" MinHeight="340" MaxHeight="590" AutomationProperties.Name="Benefit-by-benefit class comparison">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Benefit" Width="2*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="14,8"><TextBlock Text="{Binding Category}" Foreground="{StaticResource DsTextSecondaryBrush}" FontSize="11" /><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource DsPrimaryNavyBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="BaselineValueColumn" Width="3*" MinWidth="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BaselineDisplayValue}" Foreground="{StaticResource DsTextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Padding="14,10" ToolTip="{Binding EvidenceToolTip}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ComparisonValueColumn" Width="3*" MinWidth="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding ComparisonBackgroundBrush}" Padding="14,10"><TextBlock Text="{Binding ComparisonDisplayValue}" Foreground="{StaticResource DsPrimaryNavyBrush}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding EvidenceToolTip}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Difference" Width="1.5*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding DifferenceBackgroundBrush}" BorderBrush="{Binding DifferenceBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="9,4" HorizontalAlignment="Left" Margin="12,8"><TextBlock Text="{Binding DifferenceLabel}" Foreground="{Binding DifferenceForegroundBrush}" FontSize="12" FontWeight="SemiBold" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource DsSmallText}" Margin="2,8,0,0" />
    </Grid>
</UserControl>
