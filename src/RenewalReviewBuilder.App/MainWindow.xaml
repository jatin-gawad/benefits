                                            <TextBlock Text="Modelled Required Increase" Style="{StaticResource MiniLabel}" />
                                            <TextBlock x:Name="ModelledRequiredIncreaseTextBlock" Text="-" FontSize="18" FontWeight="Bold" />
                                        </StackPanel>
