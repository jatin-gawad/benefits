                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Calculated Values (Total)" FontWeight="Bold" Foreground="{StaticResource TextNavyBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Current Claims" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UnderwritingCurrentClaimsTextBlock" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Trended Claims" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UnderwritingTrendedClaimsTextBlock" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Projected Claims" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="UnderwritingProjectedClaimsTextBlock" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Required Premium" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="UnderwritingRequiredPremiumTextBlock" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Modelled Renewal Change" Style="{StaticResource MiniLabel}" />
