                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding EditableCurrentRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0000, TargetNullValue='', ValidatesOnExceptions=True}"
