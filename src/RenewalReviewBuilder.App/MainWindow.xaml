                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Pooling Threshold" Style="{StaticResource MiniLabel}" />
                                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="PoolingThresholdTextBox" Text="0" IsReadOnly="True" TextChanged="NegotiationAssumption_Changed" />
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="IBNR %" Style="{StaticResource MiniLabel}" />
                                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="IbnrTextBox" Text="0.0" IsReadOnly="True" TextChanged="NegotiationAssumption_Changed" />
                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Admin Fee %" Style="{StaticResource MiniLabel}" />
