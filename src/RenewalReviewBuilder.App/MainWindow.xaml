                                        <DataGridTextColumn Header="Modelled Change %" Binding="{Binding ModelledChangeText}" Width="130" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Negotiated Change %" Binding="{Binding NegotiatedChangeText}" Width="145" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Savings" Binding="{Binding SavingsText}" Width="105" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="125" />
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="220" />
