                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="NegotiationDateTextBox" Margin="0,0,8,0" />
                                        <TextBox Grid.Row="4" Grid.Column="2" x:Name="CarrierResponseTextBox" Margin="0,0,8,0" />
                                        <TextBox Grid.Row="4" Grid.Column="3" x:Name="ConsultantNotesTextBox" Margin="0,0,8,0" />
                                        <TextBox Grid.Row="4" Grid.Column="4" x:Name="NextActionTextBox" Margin="0,0,8,0" />
