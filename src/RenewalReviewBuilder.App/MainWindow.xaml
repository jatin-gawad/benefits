                                            <ComboBoxItem Content="Ready to Review" />
                                            <ComboBoxItem Content="Final Approved" />
                                            <ComboBoxItem Content="Watch" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Export">
                            <Border Style="{StaticResource DashboardCard}" Margin="0,12,0,0">
