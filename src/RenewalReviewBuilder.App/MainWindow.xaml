                                        <StackPanel>
                                            <TextBlock Text="Negotiated Increase" Style="{StaticResource MiniLabel}" />
                                            <TextBlock x:Name="NegotiatedIncreaseTextBlock" Text="-" FontSize="18" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Savings Achieved" Style="{StaticResource MiniLabel}" />
