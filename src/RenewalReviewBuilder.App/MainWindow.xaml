                                                   Text="Use the Net/Gross loader only when the schedule has separate Net and Gross rate columns."
                                                   Foreground="{StaticResource MutedNavyBrush}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />

                                        <Border x:Name="NetGrossRateScheduleReviewBorder"
                                                Visibility="Collapsed"
