                                                Padding="10"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="Dual-basis rate review"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextNavyBrush}" />
                                                <TextBlock Text="Excel retains Net and Gross. Client PowerPoint uses Gross only. Edit Negotiated Gross in the main grid if a manual override is required."
                                                           Foreground="{StaticResource MutedNavyBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,8" />
                                                <DataGrid x:Name="NetGrossRateScheduleReviewGrid"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          MaxHeight="230">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Benefit" Binding="{Binding BenefitLine}" Width="150" />
                                                        <DataGridTextColumn Header="Tier" Binding="{Binding ClassName}" Width="80" />
                                                        <DataGridTextColumn Header="Current Net" Binding="{Binding CurrentNetRate, StringFormat=0.000}" Width="100" />
                                                        <DataGridTextColumn Header="Current Gross" Binding="{Binding CurrentGrossRate, StringFormat=0.000}" Width="105" />
                                                        <DataGridTextColumn Header="Renewal Net" Binding="{Binding ProposedNetRate, StringFormat=0.000}" Width="100" />
                                                        <DataGridTextColumn Header="Renewal Gross" Binding="{Binding ProposedGrossRate, StringFormat=0.000}" Width="110" />
                                                        <DataGridTextColumn Header="Negotiated Net" Binding="{Binding VersionNetRate, StringFormat=0.000}" Width="110" />
