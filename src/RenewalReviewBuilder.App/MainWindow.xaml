                                    <DataGridTextColumn Header="PDF Lives" Binding="{Binding PdfLives, StringFormat={}{0:N0}}" Width="85" />
                                    <DataGridTextColumn Header="Calculated Lives" Binding="{Binding CalculatedLives, StringFormat={}{0:N0}}" Width="110" />
                                    <DataGridTextColumn Header="Lives Difference" Binding="{Binding LivesDifference, StringFormat={}{0:N0}}" Width="105" />
                                    <DataGridTextColumn Header="Lives Status" Binding="{Binding LivesStatus}" Width="100" />
                                    <DataGridTextColumn Header="PDF Premium" Binding="{Binding PdfPremium, StringFormat={}{0:N2}}" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Calculated Premium" Binding="{Binding CalculatedPremium, StringFormat={}{0:N2}}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Difference" Binding="{Binding PremiumDifference, StringFormat={}{0:N2}}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding WarningMessage}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Batch Intake" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BatchParentFolderTextBox" IsReadOnly="True" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    x:Name="SelectBatchParentFolderButton"
                                    Content="Select Document Folder"
                                    Width="170"
                                    Margin="12,0,0,0"
                                    Click="SelectBatchParentFolder_Click" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Batch Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="BatchOutputFolderTextBox" IsReadOnly="True" />
                            <WrapPanel Grid.Row="2" Grid.Column="2" Margin="12,0,0,0">
                                <Button x:Name="DocumentDiscoveryButton"
                                        Content="Document Discovery"
                                        Width="165"
                                        Margin="0,0,10,0"
                                        Click="DocumentDiscovery_Click" />
                                <Button x:Name="ProcessBatchButton"
                                        Content="Process Batch"
                                        Width="130"
                                        Margin="0,0,10,0"
                                        Background="{StaticResource DeepBlueBrush}"
                                        Foreground="White"
                                        Click="ProcessBatch_Click" />
                                <Button x:Name="OpenBatchLogButton"
                                        Content="Open Batch Log"
                                        Width="140"
                                        Margin="0,0,10,0"
                                        IsEnabled="False"
                                        Click="OpenBatchLog_Click" />
                                <Button x:Name="OpenBatchOutputFolderButton"
                                        Content="Open Output Folder"
                                        Width="160"
                                        IsEnabled="False"
                                        Click="OpenBatchOutputFolder_Click" />
                            </WrapPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Queue Actions" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                                <Button Content="Pause Processing"
                                        Width="145"
                                        Margin="0,0,10,0"
                                        Background="White"
                                        Foreground="{StaticResource TextNavyBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Click="PauseBatchProcessing_Click" />
                                <Button Content="Retry Failed"
                                        Width="125"
                                        Margin="0,0,10,0"
                                        Background="White"
                                        Foreground="{StaticResource TextNavyBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Click="RetryFailedDocuments_Click" />
                                <Button Content="Review Issues"
                                        Width="130"
                                        Margin="0,0,10,0"
                                        Background="White"
                                        Foreground="{StaticResource TextNavyBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Click="ReviewExtractionIssues_Click" />
                                <Button Content="Save Approved Results"
                                        Width="175"
                                        Margin="0,0,10,0"
                                        Background="{StaticResource TealBrush}"
                                        Foreground="White"
                                        Click="SaveApprovedBatchResults_Click" />
                                <Button Content="Export Batch Results"
                                        Width="165"
                                        Background="{StaticResource DeepBlueBrush}"
                                        Foreground="White"
                                        Click="ExportBatchResults_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <views:ControlledBookletReprocessingView Margin="0,0,0,14" />

                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Client" Style="{StaticResource MiniLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="BatchCurrentClientTextBlock" Text="-" FontWeight="Bold" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Current Workflow" Style="{StaticResource MiniLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BatchCurrentWorkflowTextBlock" Text="-" FontWeight="Bold" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Progress" Style="{StaticResource MiniLabel}" />
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,12,0">
                                <ProgressBar x:Name="BatchProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="BatchProgressCountTextBlock" Text="0 / 0" Style="{StaticResource MiniLabel}" Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Completed" Style="{StaticResource MiniLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="BatchCompletedTextBlock" Text="0" FontWeight="Bold" />

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Warnings / Failed" Style="{StaticResource MiniLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="BatchWarningFailedTextBlock" Text="0 / 0" FontWeight="Bold" />

                            <TextBlock Grid.Row="0" Grid.Column="5" Text="Estimated Time Remaining" Style="{StaticResource MiniLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="5" x:Name="BatchEtaTextBlock" Text="-" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Discovery Results" Foreground="{StaticResource DeepBlueBrush}" FontWeight="Bold" FontSize="18" />
                                    <TextBlock x:Name="BatchSummaryTextBlock" Text="Select a parent folder, then run Document Discovery." Style="{StaticResource MiniLabel}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="BatchDiscoveryGrid" MinHeight="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="180" />
                                    <DataGridTextColumn Header="Carrier" Binding="{Binding Carrier}" Width="120" />
                                    <DataGridTextColumn Header="Document Carriers" Binding="{Binding DocumentCarriersText}" Width="190" />
                                    <DataGridTextColumn Header="Document Types Found" Binding="{Binding DocumentTypesText}" Width="260" />
                                    <DataGridTextColumn Header="Booklet Count" Binding="{Binding BookletFileCount}" Width="100" />
                                    <DataGridTextColumn Header="Assigned Booklet Files" Binding="{Binding BookletFilesText}" Width="280" />
                                    <DataGridTextColumn Header="Plan Design Source" Binding="{Binding PlanDesignSource}" Width="155" />
                                    <DataGridTextColumn Header="Plan Design Status" Binding="{Binding PlanDesignStatus}" Width="155" />
                                    <DataGridTextColumn Header="Workflow Available" Binding="{Binding WorkflowsText}" Width="300" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                    <DataGridTextColumn Header="Warnings" Binding="{Binding WarningsText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="FooterActionBar"
                    Grid.Row="2"
                    Background="White"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="BusyProgressBar" Width="180" Height="8" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0" />
                        <TextBlock x:Name="StatusTextBlock" Text="Ready." Foreground="{StaticResource MutedNavyBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <WrapPanel x:Name="FooterActionsPanel" Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="OpenOutputFolderFooterButton" Content="Open Output Folder" Style="{StaticResource OutlineButtonStyle}" Width="160" Margin="0,0,10,0" Click="OpenOutputFolder_Click" IsEnabled="False" />
                        <Button x:Name="ValidateButton" Content="Validate" Style="{StaticResource PrimaryButtonStyle}" Width="115" Margin="0,0,10,0" Click="Validate_Click" />
                        <Button x:Name="ExportClaimsDataModelButton" Content="Export Claims Model" Style="{StaticResource PrimaryButtonStyle}" Width="165" Margin="0,0,10,0" Click="ExportClaimsDataModel_Click" />
                        <Button x:Name="ExportClaimsPowerPointButton" Content="Export Claims PPT" Style="{StaticResource PrimaryButtonStyle}" Width="150" Margin="0,0,10,0" Click="ExportClaimsPowerPoint_Click" />
                        <Button x:Name="ExtractBookletToMasterDbButton" Content="Extract Booklet to Master DB" Style="{StaticResource PrimaryButtonStyle}" Width="205" Margin="0,0,10,0" Click="ExtractBookletToMasterDb_Click" />
                        <Button x:Name="ExportButton" Content="Generate Review &amp; PowerPoint" Style="{StaticResource PrimaryButtonStyle}" Width="230" Click="Export_Click" />
                        <Button x:Name="FooterMoreActionsButton"
                                Content="More Actions"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="125"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                Click="FooterMoreActions_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="FooterExportClaimsDataModelMenuItem"
                                              Header="Export Claims Model"
                                              Click="ExportClaimsDataModel_Click" />
                                    <MenuItem x:Name="FooterExportClaimsPowerPointMenuItem"
                                              Header="Export Claims PPT"
                                              Click="ExportClaimsPowerPoint_Click" />
                                    <MenuItem x:Name="FooterExtractBookletToMasterDbMenuItem"
                                              Header="Extract Booklet to Master DB"
                                              Click="ExtractBookletToMasterDb_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
